rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validMood(value) {
      return value in ['great', 'good', 'okay', 'low', 'stressed'];
    }

    function validNote(value) {
      return value is string && value.size() <= 200;
    }

    // users/{uid}: a student can only read and write their own profile.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.email is string;
      allow delete: if false;
    }

    // check_ins/{id}: only the owner can read, create, update or delete.
    match /check_ins/{checkInId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'mood', 'source', 'helpType', 'note', 'createdAt'])
        && validMood(request.resource.data.mood)
         && request.resource.data.source in ['schoolwork', 'deadlines', 'relationships', 'family', 'money', 'health', 'other', 'loneliness']
        && request.resource.data.helpType in ['calmDown', 'understand', 'talk', 'justTracking']
        && validNote(request.resource.data.note)
        && request.resource.data.createdAt is timestamp;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mood', 'note'])
        && validMood(request.resource.data.mood)
        && validNote(request.resource.data.note);
    }
  }
}